# ==========================================
# 1. SECURITY & ENVIRONMENT (CRITICAL)
# ==========================================
.env
*.env
service-account.json
**/service-account.json
**/.streamlit/*
!**/.streamlit/config.toml
/secrets/

# ==========================================
# 2. DATA & LARGE FILES (DATA SCIENCE HYGIENE)
# ==========================================
*.db
*.db-journal
*.csv
*.parquet
*.jsonl
*.zip
*.gz
*.weights
*.h5
*.pkl
*.npy
/data/
/assets_ignored/

# observatory/assets/: block everything by default (private data, OCR
# screenshots, dead/unused files), open exceptions only for static
# public assets with zero sensitive data (see assets/CLAUDE.md)
/observatory/assets/*
!/observatory/assets/favicon.png
!/observatory/assets/Pienza_Papers.pdf
!/observatory/assets/Pienza_ERD.png
!/observatory/assets/kepler_3D.html
!/observatory/assets/model_audit_map.html
!/observatory/assets/latency_test_map.html
!/observatory/assets/zone-paths.js
!/observatory/assets/poly.geojson

# ==========================================
# 3. JUPYTER & SCRATCHPADS
# ==========================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*
checkpoint_*.ipynb
/observatory/jupyter_scratchpad/

# ==========================================
# 4. PYTHON & SYSTEM TRASH
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.DS_Store
node_modules/
venv/
.venv/
bin/
lib/
lib64/
dist/
wheels/
*.egg-info/

# ==========================================
# 5. LATEX BUILD ARTIFACTS
# ==========================================
*.aux
*.fdb_latexmk
*.fls
*.log
*.synctex.gz
*.toc


# ==========================================
# 6. LOCAL TOOLS & NOTES
# ==========================================
cloudflared
basic_commands.md
pienza_full_history*.txt
pienza_full_codebase.txt

.keep_alive_dummy.txt
notes.md
refactor_sprint.md


observatory/archive