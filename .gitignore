# This branch (paper-dev) only tracks The_Pienza_Papers/. Ignore everything
# else at the repo root so leftover untracked content from other branches
# (observatory/, data/, secrets/, etc., all live on disk but not on this
# branch's tree) doesn't clutter git status or risk getting added by accident.
/*
!/The_Pienza_Papers/
!/.gitignore

# LaTeX build artifacts (generated by pdflatex/latexmk/biber, not source)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.toc
*.synctex.gz
*.nav
*.snm
*.vrb

# Local compile output inside the source folders (the canonical PDF lives
# one level up, e.g. The_Pienza_Papers/Pienza_Papers_Scientific.pdf, and is
# unaffected by this since it's outside these subfolders)
The_Pienza_Papers/Pienza_Papers_Scientific/main.pdf
The_Pienza_Papers/Pienza_Papers_Executive/main.pdf
